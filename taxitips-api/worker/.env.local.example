SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
TRAFIKLAB_API_KEY=mock
# Separate Trafiklab product/subscription from TRAFIKLAB_API_KEY above --
# GTFS Regional (static schedules) vs GTFS-RT (realtime alerts) are
# independently gated; leaving this unset (or "mock") skips static ingest
# gracefully instead of erroring.
GTFS_STATIC_API_KEY=mock
TRAFIKVERKET_API_KEY=
TRAFIKVERKET_MOCK=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
POLL_INTERVAL_MS=30000
PORT=8787
