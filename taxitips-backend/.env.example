# EN databas: den Postgres som `supabase start` kör (port 54322).
# Django äger pipeline-tabellerna där via sina egna migrationer; Supabases
# SQL-migrationer äger companies/devices/profiles. Ingen tabell på två ställen.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-secret

# Datakällor. Samma nycklar som Node-workern använder.
TRAFIKVERKET_API_KEY=
TRAFIKLAB_API_KEY=
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=
# Swedavia FlightInfo v2 (apideveloper.swedavia.se). FlightInfo Free ger
# 10 001 anrop/30 dagar och skickar inga kvot-headers -- kadensen per
# flygplats och budgetvakten finns i core/thresholds.py.
SWEDAVIA_API_KEY=
# Bolagsverket (portal.api.bolagsverket.se): OAuth2 client credentials,
# Basic auth med id:secret och grant_type=client_credentials.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
BOLAGSVERKET_TOKEN_URL=https://portal.api.bolagsverket.se/oauth2/token

# Marknadsomfång (samma namn och default som Node-workern).
MARKET_SCOPE=skane
# Femton verifierade operatörskoder (mätt 2026-09-08). halland, sormland,
# jamtland, vasterbotten, norrbotten och vt saknas i Trafiklabs
# ServiceAlerts-produkt och 404:ar -- Västra Götaland täcks i stället av
# den egna Västtrafik-adaptern. Västernorrland heter `dintur`, inte
# `vasternorrland`.
TRAFIKLAB_OPERATORS=skane,sl,ul,otraf,klt,varm,dt,xt,vastmanland,krono,jlt,orebro,blekinge,gotland,dintur
# Vilka län Trafikverkets VÄGdata hämtas för -- "all" = alla 21, annars
# kommaseparerade länsnamn (se core/sources/trafikverket_road.py:COUNTY).
# Håll den i takt med MARKET_SCOPE: står den kvar på skane medan resten är
# nationell blir vägbilden tyst ofullständig.
TRAFIKVERKET_COUNTIES=skane

# Genkit/Gemini för granskning av osäkra bedömningar.
# Nyckel: https://aistudio.google.com/apikey. Gratisnivån (15 anrop/min) räcker
# lokalt; i produktion behövs fakturering på nyckelns Google Cloud-projekt
# (docs/genkit-bedomning.md §5).
GEMINI_API_KEY=
# Tak som kan höjas utan deploy (core/thresholds.py). Standard: 12 per minut,
# 3 000 lyckade per dygn, 20 texter per read_places-körning. Med betald nivå:
# AI_MAX_CALLS_PER_MINUTE=60. Månadsspärren (450 kr) ligger i koden.
# AI_MAX_CALLS_PER_MINUTE=12
# AI_DAILY_CALL_CAP=3000
# AI_PLACES_MAX_PER_RUN=20

# Celery / Redis (docker-compose.yml: redis-tjänsten)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Stripe -- ENDAST test-mode-nycklar lokalt. Se billing/webhooks.py för
# den lokala testströmmen via Stripe CLI (`stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Cloud Messaging -- samma variabelnamn som
# taxitips-api/worker/src/fcmPush.js, för kontinuitet (samma Firebase-
# projekt backar båda tjänsterna). Rå JSON eller base64-kodad JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=



# --- Förar-API:t (Spår B, core/api.py) ---------------------------------
# Supabases JWT-hemlighet, för att verifiera en INLOGGAD ägares access
# token (core/entitlement.py). Lokalt är den Supabases välkända
# dev-hemlighet och behöver inte sättas; i produktion MÅSTE den sättas,
# annars ser en ägare utan parad enhet ett tomt flöde.
#   supabase status  ->  "JWT secret"
SUPABASE_JWT_SECRET=

# Vilka origins som får läsa API:t från en webbläsare. Inget "*" -- svaren
# är entitlement-gated data. Tomt räcker för mobilappen (ingen CORS).
# Produktion måste även ha portal/admin (portal.taxitips.se, admin.taxitips.se).
APP_API_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# AISStream.io (https://aisstream.io) -- run_ais_stream
AISSTREAM_API_KEY=

# Ticketmaster Discovery API v2 (https://developer.ticketmaster.com) -- poll_events
TICKETMASTER_API_KEY=

# PredictHQ (https://docs.predicthq.com) -- poll_events
PREDICTHQ_ACCESS_TOKEN=

# TheSportsDB (https://www.thesportsdb.com) -- fotboll, ishockey och handboll i svenska ligor.
# Tom = den öppna gratisnyckeln 123. Visas i förarappen på ägarbeslutet 2026-10-09 (config/settings.py);
# tom referens = ägarbeslutets text. Stäng av med EVENTS_THESPORTSDB_SHOW_IN_APP=0.
THESPORTSDB_API_KEY=
EVENTS_THESPORTSDB_SHOW_IN_APP=1
EVENTS_THESPORTSDB_APP_REFERENCE=

# Evenemang: lagring och visning per källa (events/rights.py). En brytare utan referens
# ger ingen rätt; referensen ska peka på villkorspunkten eller det skriftliga avtalet.
EVENTS_TICKETMASTER_STORE=1
EVENTS_TICKETMASTER_STORE_REFERENCE=
# Ticketmaster visas inte i appen som standard (villkoren: inga intäkter utan avtal). 1 = visa på ägarbeslut.
EVENTS_TICKETMASTER_SHOW_IN_APP=0
EVENTS_TICKETMASTER_APP_REFERENCE=
# PredictHQ är avslutad (prenumerationen gick ut, 402 sedan 2026-09-26): hämtas, lagras och visas
# inte oavsett raderna nedan. EVENTS_PREDICTHQ_RETIRED= (tomt) återställer den, bara med ny prenumeration.
EVENTS_PREDICTHQ_STORE=0
EVENTS_PREDICTHQ_STORE_REFERENCE=
EVENTS_PREDICTHQ_SHOW_IN_APP=0
EVENTS_PREDICTHQ_APP_REFERENCE=

# --- Kundlivscykeln (fleet-appen) -------------------------------------
# Se docs/fleet-abonnemang.md §11 för utrullningsordningen.

# Kräv billicens, godkänd telefon och aktiv bilsession av ALLA.
# Tom/0 under utrullningen: ett företag utan licenser kör vidare på den gamla
# regeln, så att en deploy inte låser ute befintliga kunder. Sätts till 1 när
# `manage.py migrate_legacy_fleet` körts och kunderna är informerade.
# Återställning = sätt tillbaka till 0.
FLEET_ENFORCE_LICENSES=

# Datum (ISO 8601) då tvåfaktor börjar krävas för köp, uppsägning,
# medlemshantering och ägarbyte. Tom = kravet är inte påslaget.
FLEET_TWO_FACTOR_REQUIRED_FROM=

# Sökväg till funktionen som skickar utkorgen, t.ex. "myapp.mail.send".
# Tom = raderna skrivs men skickas inte. Lämna tom i utveckling, annars kan en
# testkörning nå en riktig kund.
FLEET_OUTBOX_SENDER=

# --- Stripe för den nya prismodellen ----------------------------------
# Produkten prenumerationsposterna skrivs mot.
STRIPE_PRODUCT_ID=
# Momssatsen som ett TaxeRate-id i Stripe. UTAN DEN SAKNAR FAKTURORNA MOMS.
STRIPE_VAT_TAX_RATE_ID=
# Måste vara "1" innan koden får röra en livenyckel. Spärren finns för att
# modulen byggdes utan tillstånd att ändra riktiga kundabonnemang.
STRIPE_ALLOW_LIVE=

# Utkorgens mejl via Hostinger (fleet/mailer.py). Tomt = inget skickas.
FLEET_SMTP_USER=
FLEET_SMTP_PASSWORD=
FLEET_SMTP_HOST=smtp.hostinger.com
FLEET_SMTP_PORT=465
FLEET_PORTAL_URL=https://taxitips.se/portal
# Driftlarm vid pipeline OK→FAIL (core/ops_alerts.py). Tomt = inga larm.
# Sätt i Coolify på backend + worker, inte här.
OPS_ALERT_EMAIL=

# Webbformulären POST /api/crm/lead direkt hit. Reach-nyckeln från hPanel → API.
HOSTINGER_API_TOKEN=
HOSTINGER_API_BASE=https://developers.hostinger.com
REACH_PROFILE_UUID=134eb837-ac0e-49bc-8540-aa02aed832e1
# Äldre hemlighet. Formuläret kräver den inte längre.
CRM_LEAD_INGEST_SECRET=
# Twenty → native CRM (manage.py import_twenty_crm). Runtime only, aldrig i git.
TWENTY_API_KEY=
TWENTY_BASE_URL=https://taxitips.tw.a2m-tech.com

# Förarinbjudan med e-post (fleet/driver_invites.py, fleet/auth_admin.py).
# Supabase service_role-nyckeln används BARA för att skapa förarens konto och
# länken där hen väljer lösenord. Tom = e-postinbjudan avslagen; bara koden visas.
#   lokalt: cd taxitips-api && supabase status -o json | grep SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=
# Sidan där föraren väljer lösenord. Samma värd som Supabase Auths SITE_URL.
FLEET_DRIVER_INVITE_REDIRECT=https://taxitips.se/forare

# Minsta/rekommenderade appversion (core/app_version.py). Vanligen satta i
# adminwebben (Status -> Appversion); de här gäller bara när fältet där är tomt.
# Form: 1.2.3 eller 1.2.3+45.
APP_ANDROID_MIN_VERSION=
APP_ANDROID_RECOMMENDED_VERSION=
APP_IOS_MIN_VERSION=
APP_IOS_RECOMMENDED_VERSION=
APP_IOS_STORE_URL=
