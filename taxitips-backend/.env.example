# Lokal utveckling. Kopiera till .env.
# Dedikerad Postgres+TimescaleDB-container (docker-compose.yml) -- OBS,
# BRYTANDE ÄNDRING mot tidigare: pekade förut på supabase starts instans
# (127.0.0.1:54322), pekar nu på den nya `db`-tjänsten. Befintliga lokala
# uppsättningar måste uppdatera detta manuellt.
DATABASE_URL=postgresql://taxitips:taxitips@127.0.0.1:5432/taxitips
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-secret

# Datakällor. Samma nycklar som Node-workern använder.
TRAFIKVERKET_API_KEY=
TRAFIKLAB_API_KEY=
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=

# Marknadsomfång (samma namn och default som Node-workern).
MARKET_SCOPE=skane
TRAFIKLAB_OPERATORS=skane

# Genkit/Gemini för granskning av osäkra bedömningar.
# Nyckel: https://aistudio.google.com/apikey  (gratisnivå räcker)
GEMINI_API_KEY=

# Celery / Redis (docker-compose.yml: redis-tjänsten)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Stripe -- ENDAST test-mode-nycklar lokalt. Se billing/webhooks.py för
# den lokala testströmmen via Stripe CLI (`stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Cloud Messaging -- samma variabelnamn som
# taxitips-api/worker/src/fcmPush.js, för kontinuitet (samma Firebase-
# projekt backar båda tjänsterna). Rå JSON eller base64-kodad JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase-korskoppling: companies/devices/processed_webhook_events --
# Supabases egna migrationer äger dessa, aldrig Djangos (se
# billing/db_router.py). Använd den skopade django_billing-rollen
# (schema/django_billing_role.sql, körs en gång manuellt), ALDRIG
# SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_DATABASE_URL=postgresql://django_billing:django_billing@127.0.0.1:54322/postgres

# Dedikerad Postgres+TimescaleDB-container, bootstrap-variabler som
# DATABASE_URL ovan byggs mot (docker-compose.yml läser dessa direkt).
POSTGRES_USER=taxitips
POSTGRES_PASSWORD=taxitips
POSTGRES_DB=taxitips
