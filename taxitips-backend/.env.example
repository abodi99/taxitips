# EN databas: den Postgres som `supabase start` kör (port 54322).
# Django äger pipeline-tabellerna där via sina egna migrationer; Supabases
# SQL-migrationer äger companies/devices/profiles. Ingen tabell på två ställen.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-not-a-secret

# Datakällor. Samma nycklar som Node-workern använder.
TRAFIKVERKET_API_KEY=
TRAFIKLAB_API_KEY=
VASTTRAFIK_CLIENT_ID=
VASTTRAFIK_CLIENT_SECRET=

# Marknadsomfång (samma namn och default som Node-workern).
MARKET_SCOPE=skane
# Femton verifierade operatörskoder (mätt 2026-09-08). halland, sormland,
# jamtland, vasterbotten, norrbotten och vt saknas i Trafiklabs
# ServiceAlerts-produkt och 404:ar -- Västra Götaland täcks i stället av
# den egna Västtrafik-adaptern. Västernorrland heter `dintur`, inte
# `vasternorrland`.
TRAFIKLAB_OPERATORS=skane,sl,ul,otraf,klt,varm,dt,xt,vastmanland,krono,jlt,orebro,blekinge,gotland,dintur
# Vilka län Trafikverkets VÄGdata hämtas för -- "all" = alla 21, annars
# kommaseparerade länsnamn (se core/sources/trafikverket_road.py:COUNTY).
# Håll den i takt med MARKET_SCOPE: står den kvar på skane medan resten är
# nationell blir vägbilden tyst ofullständig.
TRAFIKVERKET_COUNTIES=skane

# Genkit/Gemini för granskning av osäkra bedömningar.
# Nyckel: https://aistudio.google.com/apikey  (gratisnivå räcker)
GEMINI_API_KEY=

# Celery / Redis (docker-compose.yml: redis-tjänsten)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Stripe -- ENDAST test-mode-nycklar lokalt. Se billing/webhooks.py för
# den lokala testströmmen via Stripe CLI (`stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Cloud Messaging -- samma variabelnamn som
# taxitips-api/worker/src/fcmPush.js, för kontinuitet (samma Firebase-
# projekt backar båda tjänsterna). Rå JSON eller base64-kodad JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=



# --- Förar-API:t (Spår B, core/api.py) ---------------------------------
# Supabases JWT-hemlighet, för att verifiera en INLOGGAD ägares access
# token (core/entitlement.py). Lokalt är den Supabases välkända
# dev-hemlighet och behöver inte sättas; i produktion MÅSTE den sättas,
# annars ser en ägare utan parad enhet ett tomt flöde.
#   supabase status  ->  "JWT secret"
SUPABASE_JWT_SECRET=

# Vilka origins som får läsa API:t från en webbläsare. Inget "*" -- svaren
# är entitlement-gated data. Tomt räcker för mobilappen (ingen CORS).
APP_API_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
