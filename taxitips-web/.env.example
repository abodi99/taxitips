# Formulären postar till VITE_API_BASE_URL/api/crm/lead (Django).
# Hostinger-nyckeln sätts på taxitips-backend, inte här.

# Paste into js/config.js (or host as build-time inject)
SUPABASE_URL=http://supabasekong-kjrcb9ghbpegwyyxb05vjo66.192.168.0.7.sslip.io:8000
SUPABASE_ANON_KEY=

# --- Kundportalen (portal.html) ---------------------------------------
# Supabase används bara för inloggningen; all kunddata går via backenden.
# Anon-nyckeln är publik med avsikt och ger ingen åtkomst: domäntabellerna har
# RLS (20260920000002_lock_down_domain_tables.sql) och fleet-tabellerna är inte
# nåbara via PostgREST alls.
#
# Två lokala lägen (Vite läser .env, sedan .env.local som vinner):
#
# 1) Portalen mot PRODUKTION (vanligast för webb-UI) — lägg i .env.local:
#    VITE_SUPABASE_URL=https://api.taxitips.se
#    VITE_SUPABASE_ANON_KEY=<produktionens anon-nyckel>
#    VITE_API_BASE_URL=https://backend.taxitips.se
#    Backend CORS måste tillåta http://127.0.0.1:5173 (APP_API_ALLOWED_ORIGINS).
#
# 2) Full lokal stack — .env utan .env.local, plus `supabase start` och
#    Django på :8000:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000
